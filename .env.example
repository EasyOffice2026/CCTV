# Copy to cloud/.env for local development. Dev-only values.
CCTV_ENVIRONMENT=dev
CCTV_DATABASE_URL=postgresql+psycopg://cctv_app:cctv_app@localhost:5432/cctv
CCTV_MIGRATION_DATABASE_URL=postgresql+psycopg://cctv_owner:cctv_owner@localhost:5432/cctv
CCTV_APP_DB_ROLE=cctv_app
# Signs tokens and encrypts 2FA secrets. Required (32+ random characters) outside dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CCTV_SECRET_KEY=
CCTV_WEB_URL=http://localhost:3000
CCTV_REDIS_URL=redis://localhost:6379/0
CCTV_S3_ENDPOINT_URL=http://localhost:9000
CCTV_S3_BUCKET=cctv-media
CCTV_S3_ACCESS_KEY=cctv
CCTV_S3_SECRET_KEY=cctv-dev-secret

# The cloud test suite reads these from the shell environment (not from .env):
#   CCTV_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://cctv_owner:cctv_owner@localhost:5432/cctv_test
#   CCTV_TEST_DATABASE_URL=postgresql+psycopg://cctv_app:cctv_app@localhost:5432/cctv_test

# Edge service (edge/README.md). On a Jetson these live in /etc/cctv-edge/edge.env.
# CCTV_EDGE_CLOUD_URL=http://localhost:8000
# CCTV_EDGE_DEVICE_TOKEN=
# CCTV_EDGE_DATA_DIR=./.edge-data
# CCTV_EDGE_CREDENTIALS_FILE=./.edge-data/credentials.json
