# ${API_UPSTREAM}: the API (http://api:8000). ${MEDIA_ORIGIN}: where pre-signed snapshot and
# clip URLs point (object storage), allowed by the Content-Security-Policy below.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # Face enrolment uploads up to 5 photos of 5 MB.
    client_max_body_size 30m;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${MEDIA_ORIGIN}; media-src 'self' blob: ${MEDIA_ORIGIN}; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    # The site is only served over TLS (plan 7.1; the load balancer in front ends TLS).
    # Browsers ignore this header on plain-http responses, e.g. the local dev stack.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Pre-signed media URLs must not leak to other sites.
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Edge long polls hold up to 55 s; the event WebSocket pings every 25 s.
        proxy_read_timeout 75s;
        proxy_buffering off;
    }

    location /_next/static/ {
        expires 1y;  # file names contain a content hash
    }

    location / {
        try_files $uri $uri/ $uri.html /404.html;
    }
}
