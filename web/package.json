{
  "name": "cctv-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web dashboard and admin panel for the AI CCTV system",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript ../cloud/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
